# Local placeholders for docker compose. Copy to .env (git ignores it) before the first run.
# Nothing here is used outside a developer machine; AWS reads secrets from Secrets Manager.

# SQL Server sa password (8+ characters with upper, lower, digit and symbol).
MSSQL_SA_PASSWORD=Local_Dev_Only_1!

# Shared by the notifier (Notifier__SigningSecret) and the fake supplier (SigningSecret).
WEBHOOK_SIGNING_SECRET=local-signing-secret-change-me

# Development mounts Scalar at /scalar/v1; any other value leaves it off.
ASPNETCORE_ENVIRONMENT=Development
